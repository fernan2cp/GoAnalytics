# =========================================================
# ENV Ejemplo y de uso para Docker-compose de Sandbox
# =========================================================

# =========================================================
# App
# =========================================================
APP_ENV=development
APP_NAME=go-analytics
LOG_LEVEL=info

# =========================================================
# Ingest HTTP service
# =========================================================
INGEST_HTTP_HOST=0.0.0.0
INGEST_HTTP_PORT=8080

# =========================================================
# JWT
# =========================================================
JWT_ALGORITHM=HS256
GO_ANALYTICS_JWT_SECRET=change_me_in_production
JWT_ISSUER=main-backend
JWT_AUDIENCE=analytics-ingest
JWT_EXPIRATION_MINUTES=1440
INGEST_HIDE_AUTH_FAILURES=false

# =========================================================
# Redis - dentro de Docker usar el nombre del servicio, no localhost
# =========================================================
REDIS_ADDR=redis:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

EVENT_STREAM_NAME=goanalytics:events:raw
EVENT_STREAM_MAXLEN=1000000
REJECTED_STREAM_NAME=goanalytics:events:rejected
UNRESOLVED_STREAM_NAME=goanalytics:events:unresolved

# =========================================================
# Rate limit
# =========================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_EVENTS_PER_MINUTE_PER_SITE=3000
RATE_LIMIT_EVENTS_PER_MINUTE_PER_IP=1000

# =========================================================
# Payload limits
# =========================================================
MAX_EVENTS_PER_BATCH=50
MAX_EVENT_PAYLOAD_BYTES=65536
MAX_PROPERTY_KEYS=50
MAX_PROPERTY_DEPTH=5

# =========================================================
# CORS
# =========================================================
CORS_ALLOWED_ORIGINS=*

# =========================================================
# Worker
# =========================================================
WORKER_NAME=go-analytics-worker-1
WORKER_CONSUMER_GROUP=go-analytics-workers
WORKER_BATCH_SIZE=500
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEALTH_HTTP_HOST=0.0.0.0
WORKER_HEALTH_HTTP_PORT=8080

# =========================================================
# PostgreSQL - dentro de Docker usar el nombre del servicio, no localhost
# =========================================================
POSTGRES_HOST=postgres_analytics
POSTGRES_PORT=5432
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
POSTGRES_DB=analytics
POSTGRES_SSLMODE=disable

# =========================================================
# Site resolver / rehidratacion
# =========================================================
# Opcion B - si el resolver corre dentro del servicio sandbox, usar algo similar a:
SITE_RESOLVER_URL=http://sandbox:3000/api/v1/internal/analytics/sites/resolve

SITE_RESOLVER_TOKEN=change_me
SITE_RESOLVER_TIMEOUT_MS=300
SITE_REHYDRATE_COOLDOWN_SECONDS=300
SITE_NEGATIVE_CACHE_TTL_SECONDS=300
SITE_CACHE_TTL_SECONDS=3600
