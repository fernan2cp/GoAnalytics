{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goanalytics.local/contracts/context-registry/v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "registry_revision", "contexts"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_version": {"type": "integer", "minimum": 1},
    "registry_revision": {"type": "string", "minLength": 1, "maxLength": 255},
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context_key", "context_version", "context_family", "parent_context_key", "parent_context_version", "status"],
        "properties": {
          "context_key": {"type": "string", "minLength": 1, "maxLength": 255},
          "context_version": {"type": "integer", "minimum": 1},
          "context_family": {"enum": ["search", "selection", "transaction", "service", "support", "content", "navigation"]},
          "parent_context_key": {"type": ["string", "null"]},
          "parent_context_version": {"type": ["integer", "null"], "minimum": 1},
          "status": {"enum": ["active", "inactive"]}
        }
      }
    }
  }
}
